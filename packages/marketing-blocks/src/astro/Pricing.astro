---
// Custom Portable Text block (_type: "marketing.pricing"). See Hero.astro
// for the re-theming rationale. No box-shadow/scale-up "highlighted" treatment
// (this site has no shadows anywhere) -- the highlighted plan is marked with
// a solid accent-colored badge and border instead.
// The one deliberate coupling to the host site: CTAs reuse its Button so they
// match every other button (Astro scopes Button.astro's styles to its own markup).
import Button from "../../../../src/components/Button.astro";
import { resolveHref } from "./links";

interface RawPlan {
	name: string;
	price: string;
	period?: string;
	description?: string;
	// Features are stored as a newline-separated string (Block Kit has no
	// list-of-strings element, so a multiline text input is the closest fit).
	features?: string;
	// CTAs are flattened to sibling fields because Block Kit has no
	// object-group element.
	ctaLabel?: string;
	ctaUrl?: string;
	highlighted?: boolean;
}

interface Props {
	node: {
		headline?: string;
		// Editor-authored, not a hardcoded string -- this block gets no
		// `locale` prop (PortableText block components only receive `node`),
		// so it can't route a default through src/i18n/ui.ts the way the rest
		// of the site's UI strings do.
		badgeLabel?: string;
		plans: RawPlan[];
	};
}

const { node } = Astro.props;
const { headline, badgeLabel, plans: rawPlans } = node;

const plans = rawPlans.map((plan) => ({
	...plan,
	features: (plan.features ?? "")
		.split("\n")
		.map((s) => s.trim())
		.filter(Boolean),
	cta: {
		label: plan.ctaLabel ?? "",
		url: resolveHref(plan.ctaUrl, Astro.currentLocale) ?? "#",
	},
}));
---

<section class="marketing-pricing">
	{
		headline && (
			<header class="marketing-pricing__header">
				<h2>{headline}</h2>
			</header>
		)
	}
	<div class="marketing-pricing__grid">
		{
			plans.map((plan) => (
				<div
					class:list={["marketing-pricing__card", { "marketing-pricing__card--highlighted": plan.highlighted }]}
				>
					{plan.highlighted && badgeLabel && <span class="marketing-pricing__badge">{badgeLabel}</span>}
					<div class="marketing-pricing__plan-header">
						<h3 class="marketing-pricing__name">{plan.name}</h3>
						<div class="marketing-pricing__price">
							<span class="marketing-pricing__amount">{plan.price}</span>
							{plan.period && <span class="marketing-pricing__period">{plan.period}</span>}
						</div>
						{plan.description && <p class="marketing-pricing__description">{plan.description}</p>}
					</div>
					<ul class="marketing-pricing__features">
						{plan.features.map((feature) => (
							<li>
								<svg class="marketing-pricing__check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path
										fill-rule="evenodd"
										d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
										clip-rule="evenodd"
									/>
								</svg>
								{feature}
							</li>
						))}
					</ul>
					<Button href={plan.cta.url} variant={plan.highlighted ? "accent" : "outline"} class="marketing-pricing__cta">
						{plan.cta.label}
					</Button>
				</div>
			))
		}
	</div>
</section>

<style lang="scss">
	.marketing-pricing {
		padding-block: var(--s-9);

		&__header {
			margin-bottom: var(--s-8);
		}

		&__grid {
			display: grid;
			gap: var(--s-6);
			align-items: start;

			@include respond(md) {
				grid-template-columns: repeat(3, 1fr);
			}
		}

		&__card {
			position: relative;
			padding: var(--s-7);
			background: var(--c-white);
			border: 1px solid var(--c-border);
			border-radius: var(--s-2);
			display: flex;
			flex-direction: column;
			gap: var(--s-4);

			&--highlighted {
				border-color: var(--c-lamp-500);
			}
		}

		&__badge {
			position: absolute;
			top: 0;
			left: var(--s-7);
			transform: translateY(-50%);
			padding: var(--s-1) var(--s-3);
			font-size: var(--fs-200);
			font-weight: 700;
			color: var(--c-spruce-900);
			background: var(--c-lamp-500);
			border-radius: var(--s-1);
		}

		&__plan-header {
			text-align: center;
			padding-bottom: var(--s-4);
			border-bottom: 1px solid var(--c-border);
		}

		&__name {
			margin-bottom: var(--s-2);
		}

		&__price {
			display: flex;
			align-items: baseline;
			justify-content: center;
			gap: var(--s-1);
			margin-bottom: var(--s-2);
		}

		&__amount {
			font-family: var(--font-display);
			font-size: var(--fs-800);
			font-weight: 700;
		}

		&__period,
		&__description {
			font-size: var(--fs-300);
			color: var(--c-text-muted);
		}

		&__features {
			list-style: none;
			flex: 1;
			display: flex;
			flex-direction: column;
			gap: var(--s-2);
			margin: 0;
			padding: 0;

			li {
				display: flex;
				align-items: flex-start;
				gap: var(--s-2);
				font-size: var(--fs-300);
			}
		}

		&__check {
			width: 1.125rem;
			height: 1.125rem;
			flex-shrink: 0;
			color: var(--c-spruce-600);
			margin-top: 2px;
		}

		&__cta {
			width: 100%;
		}
	}
</style>
