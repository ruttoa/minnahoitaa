---
interface Props {
	icon: "pets" | "cleaning" | "garden";
	class?: string;
}

const { icon, class: className } = Astro.props;
---

{
	icon === "pets" && (
		<svg
			viewBox="0 0 24 24"
			class={className}
			aria-hidden="true"
			focusable="false"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			fill="none"
		>
			<ellipse cx="12" cy="16" rx="5" ry="4" />
			<ellipse cx="5.5" cy="9.5" rx="1.8" ry="2.2" />
			<ellipse cx="9.5" cy="6" rx="1.8" ry="2.2" />
			<ellipse cx="14.5" cy="6" rx="1.8" ry="2.2" />
			<ellipse cx="18.5" cy="9.5" rx="1.8" ry="2.2" />
		</svg>
	)
}
{
	icon === "cleaning" && (
		<svg
			viewBox="0 0 24 24"
			class={className}
			aria-hidden="true"
			focusable="false"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			fill="none"
		>
			<path d="M10 3.5h3l.6 3.5H9.4z" />
			<path d="M9 7h6l1 12.5a1.5 1.5 0 0 1-1.5 1.5h-5A1.5 1.5 0 0 1 8 19.5z" />
			<path d="M9.5 11.5h5" />
			<path d="M17.5 4.5l1.2-1.2M19.5 7h1.7M17.5 9.5l1.2 1.2" />
		</svg>
	)
}
{
	icon === "garden" && (
		<svg
			viewBox="0 0 24 24"
			class={className}
			aria-hidden="true"
			focusable="false"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			fill="none"
		>
			<path d="M12 21V10.5" />
			<path d="M12 12c0-3.5-2.5-6-6.5-6C5.5 10 8 12.5 12 12Z" />
			<path d="M12 9c0-3 2-5.5 5.5-5.5C17.5 7 15.5 9 12 9Z" />
		</svg>
	)
}
