---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "emdash/ui";
import Button from "./Button.astro";
import { useTranslations, type Locale } from "../i18n/ui";
import { CONTACT_PATH } from "../lib/routes";

interface Props {
	locale: Locale;
	heading: string;
	intro: string;
	image?: { id: string; src?: string; alt?: string; width?: number; height?: number } | null;
}

const { locale, heading, intro, image } = Astro.props;
const t = useTranslations(locale);
const contactHref = getRelativeLocaleUrl(locale, CONTACT_PATH);
---

<section class="hero l-container">
	<div class="hero__content">
		<h1 class="hero__heading">{heading}</h1>
		<p class="hero__intro">{intro}</p>
		<Button href={contactHref} variant="accent" class="hero__cta">{t("cta.contact")}</Button>
	</div>

	<div class="hero__portrait">
		<div class="hero__glow" aria-hidden="true"></div>
		{image?.src && <Image image={image} />}
	</div>
</section>

<style lang="scss">
	.hero {
		display: grid;
		gap: var(--s-8);
		align-items: center;
		padding-block: var(--s-9) var(--s-11);

		@include respond(md) {
			grid-template-columns: 1.1fr 0.9fr;
			padding-block: var(--s-11) var(--s-12);
		}

		&__heading {
			@include reduced-motion {
				animation: hero-reveal var(--dur-slow) var(--ease-standard) both;
			}
		}

		&__intro {
			font-size: var(--fs-500);
			color: var(--c-text-muted);
			margin-top: var(--s-5);

			@include reduced-motion {
				animation: hero-reveal var(--dur-slow) var(--ease-standard) 80ms both;
			}
		}

		&__cta {
			margin-top: var(--s-7);

			@include reduced-motion {
				animation: hero-reveal var(--dur-slow) var(--ease-standard) 160ms both;
			}
		}

		&__portrait {
			position: relative;
			aspect-ratio: 4 / 5;
			border-radius: var(--s-3);
			overflow: hidden;
			background: var(--c-frost-050);

			img {
				position: relative;
				z-index: 1;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			@include reduced-motion {
				animation: hero-reveal var(--dur-slow) var(--ease-standard) 240ms both;
			}
		}

		&__glow {
			position: absolute;
			inset: -20%;
			background: radial-gradient(circle at 55% 40%, var(--c-lamp-500) 0%, transparent 60%);
			filter: blur(3.5rem);
			opacity: 0.55;
		}
	}

	@keyframes hero-reveal {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
