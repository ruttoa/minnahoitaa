---
import PageLayout from "../../layouts/PageLayout.astro";
import GalleryGrid from "../GalleryGrid.astro";
import { useTranslations, isLocale, defaultLocale } from "../../i18n/ui";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = useTranslations(locale);
---

<PageLayout title={t("pages.galleryHeading")} heading={t("pages.galleryHeading")}>
	<div class="l-container">
		<GalleryGrid locale={locale} />
	</div>
</PageLayout>
