---
import { getEmDashCollection } from "emdash";
import PageLayout from "../../layouts/PageLayout.astro";
import ServiceSection from "../ServiceSection.astro";
import ContactBand from "../ContactBand.astro";
import { useTranslations, isLocale, defaultLocale } from "../../i18n/ui";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = useTranslations(locale);

const { entries: services, cacheHint } = await getEmDashCollection("services", {
	locale,
	orderBy: { order: "asc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<PageLayout title={t("pages.servicesHeading")} heading={t("pages.servicesHeading")}>
	{
		services.map((service, i) => (
			<ServiceSection
				locale={locale}
				slug={service.id}
				title={service.data.title}
				icon={service.data.icon}
				body={service.data.body}
				bullets={service.data.bullets as { text: string }[] | undefined}
				image={service.data.image}
				reverse={i % 2 === 1}
			/>
		))
	}

	<ContactBand locale={locale} />
</PageLayout>
