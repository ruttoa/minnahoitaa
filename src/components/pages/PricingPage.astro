---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import PageLayout from "../../layouts/PageLayout.astro";
import PriceTable from "../PriceTable.astro";
import ContactBand from "../ContactBand.astro";
import { useTranslations, isLocale, defaultLocale } from "../../i18n/ui";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = useTranslations(locale);

const { entry: termsEntry, cacheHint } = await getEmDashEntry("pages", "hinnasto-ehdot", { locale });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<PageLayout title={t("pages.pricingHeading")} heading={t("pages.pricingHeading")}>
	<div class="l-container hinnasto">
		<PriceTable locale={locale} />

		{
			termsEntry && (
				<div class="hinnasto__terms">
					<PortableText value={termsEntry.data.content} />
				</div>
			)
		}
	</div>

	<ContactBand locale={locale} />
</PageLayout>

<style lang="scss">
	.hinnasto {
		padding-bottom: var(--s-11);

		&__terms {
			max-width: 44rem;
			margin-top: var(--s-11);
			padding-top: var(--s-9);
			border-top: 1px solid var(--c-border);
			display: flex;
			flex-direction: column;
			gap: var(--s-4);
			color: var(--c-text-muted);

			a {
				color: var(--c-spruce-600);
			}
		}
	}
</style>
