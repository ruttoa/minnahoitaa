---
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales, useTranslations, type Locale } from "../i18n/ui";

interface Props {
	locale: Locale;
	currentPath: string;
}

const { locale, currentPath } = Astro.props;
const otherLocale = locales.find((loc) => loc !== locale) as Locale;
const t = useTranslations(locale);

// Strip the current locale prefix (if any) to get the locale-agnostic path,
// then rebuild it for the other locale. Same page, different language —
// never a blind link to the homepage.
const pathWithoutLocale = currentPath.replace(/^\/(fi|en)(\/|$)/, "/");
const switchHref = getRelativeLocaleUrl(otherLocale, pathWithoutLocale);
---

<a href={switchHref} class="language-switcher" hreflang={otherLocale} lang={otherLocale}>
	{t("nav.languageSwitch")}
</a>

<style lang="scss">
	.language-switcher {
		font-size: var(--fs-300);
		font-weight: 600;
		text-decoration: none;
		color: var(--c-text-muted);
		padding: var(--s-2);

		&:hover {
			color: var(--c-spruce-600);
		}
	}
</style>
