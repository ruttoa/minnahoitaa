---
// Scroll-triggered fade-up for elements marked [data-reveal]. One of the
// three sanctioned motion moments (see PLAN.md §2) — hero reveal and the
// hover lamp glow are the other two. No markup: this only wires the
// IntersectionObserver. Elements are visible-by-default (no-JS baseline);
// the hide-then-reveal state only applies once `html.js` is present (see
// BaseLayout's bootstrap script) and only under prefers-reduced-motion: none.
---

<style lang="scss" is:global>
	@media (prefers-reduced-motion: no-preference) {
		html.js [data-reveal] {
			opacity: 0;
			transform: translateY(1rem);
			transition:
				opacity var(--dur-slow) var(--ease-standard),
				transform var(--dur-slow) var(--ease-standard);
		}

		html.js [data-reveal].is-visible {
			opacity: 1;
			transform: none;
		}

		html.js [data-reveal-group] > *:nth-child(1) {
			transition-delay: 0ms;
		}
		html.js [data-reveal-group] > *:nth-child(2) {
			transition-delay: 80ms;
		}
		html.js [data-reveal-group] > *:nth-child(3) {
			transition-delay: 160ms;
		}
		html.js [data-reveal-group] > *:nth-child(4) {
			transition-delay: 240ms;
		}
	}
</style>

<script>
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				}
			}
		},
		{ rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
	);

	document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
</script>
