---
import { Image, PortableText } from "emdash/ui";
import ServiceIcon from "./ServiceIcon.astro";
import Button from "./Button.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Locale } from "../i18n/ui";
import { CONTACT_PATH } from "../lib/routes";
import type { PortableTextBlock } from "emdash";

interface Props {
	locale: Locale;
	slug: string;
	title: string;
	icon: "pets" | "cleaning" | "garden";
	body: PortableTextBlock[];
	bullets?: { text: string }[];
	image?: { id: string; src?: string; alt?: string; width?: number; height?: number } | null;
	reverse?: boolean;
}

const { locale, slug, title, icon, body, bullets, image, reverse = false } = Astro.props;
const t = useTranslations(locale);
const contactHref = getRelativeLocaleUrl(locale, CONTACT_PATH);
---

<section id={slug} class={`service-section l-container${reverse ? " service-section--reverse" : ""}`}>
	<div class="service-section__media" aria-hidden={image ? undefined : "true"}>
		{
			image?.src ? (
				<Image image={image} />
			) : (
				<div class={`service-section__glyph service-section__glyph--${icon}`}>
					<ServiceIcon icon={icon} />
				</div>
			)
		}
	</div>

	<div class="service-section__content">
		<span class="service-section__icon">
			<ServiceIcon icon={icon} />
		</span>
		<h2>{title}</h2>
		<div class="service-section__body">
			<PortableText value={body} />
		</div>

		{
			bullets && bullets.length > 0 && (
				<ul class="service-section__bullets">
					{bullets.map((b) => (
						<li>{b.text}</li>
					))}
				</ul>
			)
		}

		<Button href={contactHref} variant="accent">{t("cta.contact")}</Button>
	</div>
</section>

<style lang="scss">
	.service-section {
		display: grid;
		gap: var(--s-8);
		padding-block: var(--s-9);
		scroll-margin-top: var(--s-9);
		border-top: 1px solid var(--c-border);

		@include respond(md) {
			grid-template-columns: 1fr 1fr;
			align-items: center;
		}

		&--reverse {
			@include respond(md) {
				.service-section__media {
					order: 2;
				}
			}
		}

		&__media {
			position: relative;
			border-radius: var(--s-3);
			overflow: hidden;
			background: var(--c-frost-050);
			min-height: 16rem;
			display: flex;
			align-items: center;
			justify-content: center;

			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
		}

		&__glyph {
			position: relative;
			width: 100%;
			height: 100%;
			min-height: 16rem;
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--c-spruce-600);

			&::before {
				content: "";
				position: absolute;
				inset: 0;
				background: radial-gradient(circle at 50% 45%, var(--c-lamp-500) 0%, transparent 65%);
				filter: blur(3rem);
				opacity: 0.35;
			}

			svg {
				position: relative;
				width: 5rem;
				height: 5rem;
				stroke-width: 1;
			}
		}

		&__icon {
			display: inline-flex;
			width: 2.5rem;
			height: 2.5rem;
			align-items: center;
			justify-content: center;
			border-radius: 50%;
			background: var(--c-frost-050);
			color: var(--c-spruce-600);
			margin-bottom: var(--s-4);

			svg {
				width: 1.25rem;
				height: 1.25rem;
			}
		}

		&__body {
			color: var(--c-text);
			display: flex;
			flex-direction: column;
			gap: var(--s-4);
			margin-block: var(--s-4);
		}

		&__bullets {
			display: flex;
			flex-direction: column;
			gap: var(--s-2);
			margin-bottom: var(--s-6);

			li {
				padding-left: var(--s-6);
				position: relative;
				color: var(--c-text-muted);

				&::before {
					content: "";
					position: absolute;
					left: 0;
					top: 0.6em;
					width: 0.5rem;
					height: 0.5rem;
					border-radius: 50%;
					background: var(--c-lamp-500);
				}
			}
		}
	}
</style>
