---
import { getEmDashCollection } from "emdash";
import PageLayout from "../../layouts/PageLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
import { useTranslations, isLocale, defaultLocale } from "../../i18n/ui";
import { formatPhoneDisplay } from "../../lib/format";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = useTranslations(locale);

const { entries: businessInfoEntries, cacheHint } = await getEmDashCollection("business_info", { limit: 1 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const info = businessInfoEntries[0]?.data;

const telHref = info ? `tel:${info.phone_e164}` : undefined;
const mailHref = info ? `mailto:${info.email}` : undefined;
const whatsappHref = info?.whatsapp_e164 ? `https://wa.me/${info.whatsapp_e164.replace("+", "")}` : undefined;
---

<PageLayout title="Ota yhteyttä" heading="Ota yhteyttä" intro={t("contact.intro")}>
	<div class="l-container contact-page">
		{
			info && (
				<aside class="contact-page__details" aria-label={t("contact.formHeading")}>
					<p class="contact-page__response-time">{t("contact.responseTime")}</p>

					<dl>
						<div>
							<dt>{t("contact.phoneLabel")}</dt>
							<dd>
								<a href={telHref}>{formatPhoneDisplay(info.phone_e164)}</a>
							</dd>
						</div>
						<div>
							<dt>{t("contact.emailLabel")}</dt>
							<dd>
								<a href={mailHref}>{info.email}</a>
							</dd>
						</div>
						{whatsappHref && (
							<div>
								<dt>WhatsApp</dt>
								<dd>
									<a href={whatsappHref} target="_blank" rel="noopener noreferrer">
										{t("cta.whatsapp")}
									</a>
								</dd>
							</div>
						)}
						<div>
							<dt>{t("contact.serviceAreaLabel")}</dt>
							<dd>{info.service_area}</dd>
						</div>
						<div>
							<dt>{t("contact.businessIdLabel")}</dt>
							<dd>{info.business_id}</dd>
						</div>
					</dl>
				</aside>
			)
		}

		<div class="contact-page__form">
			<h2>{t("contact.formHeading")}</h2>
			<ContactForm locale={locale} />
		</div>
	</div>
</PageLayout>

<style lang="scss">
	.contact-page {
		display: grid;
		gap: var(--s-9);
		padding-bottom: var(--s-11);

		@include respond(md) {
			grid-template-columns: 1fr 1.3fr;
			align-items: start;
		}

		&__details {
			background: var(--c-white);
			border: 1px solid var(--c-border);
			border-radius: var(--s-2);
			padding: var(--s-7);

			dl {
				display: flex;
				flex-direction: column;
				gap: var(--s-5);
				margin-top: var(--s-6);
			}

			dt {
				font-size: var(--fs-300);
				color: var(--c-text-muted);
				font-weight: 600;
			}

			dd a {
				color: var(--c-spruce-600);
				font-weight: 600;
			}
		}

		&__response-time {
			color: var(--c-text-muted);
		}
	}
</style>
