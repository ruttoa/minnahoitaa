---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, isLocale, defaultLocale } from "../i18n/ui";
import { CONTACT_PATH } from "../lib/routes";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const t = useTranslations(locale);
---

<BaseLayout title={t("404.title")}>
	<div class="l-container not-found">
		<h1>{t("404.title")}</h1>
		<p>{t("404.body")}</p>
		<div class="not-found__actions">
			<Button href={getRelativeLocaleUrl(locale, "/")} variant="primary">{t("404.homeLink")}</Button>
			<Button href={getRelativeLocaleUrl(locale, CONTACT_PATH)} variant="outline">{t("404.contactLink")}</Button>
		</div>
	</div>
</BaseLayout>

<style lang="scss">
	.not-found {
		padding-block: var(--s-12);
		text-align: center;

		&__actions {
			display: flex;
			gap: var(--s-4);
			justify-content: center;
			margin-top: var(--s-7);
			flex-wrap: wrap;
		}
	}
</style>
