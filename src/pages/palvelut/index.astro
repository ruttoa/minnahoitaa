---
import { getEmDashCollection } from "emdash";
import PageLayout from "../../layouts/PageLayout.astro";
import ServiceSection from "../../components/ServiceSection.astro";
import ContactBand from "../../components/ContactBand.astro";
import { isLocale, defaultLocale } from "../../i18n/ui";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;

const { entries: services, cacheHint } = await getEmDashCollection("services", {
	locale,
	orderBy: { order: "asc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<PageLayout title="Palvelut" heading="Palvelut">
	{
		services.map((service, i) => (
			<ServiceSection
				locale={locale}
				slug={service.id}
				title={service.data.title}
				icon={service.data.icon}
				body={service.data.body}
				bullets={service.data.bullets as { text: string }[] | undefined}
				image={service.data.image}
				reverse={i % 2 === 1}
			/>
		))
	}

	<ContactBand locale={locale} />
</PageLayout>
