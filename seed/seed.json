				"slug": "lemmikkihoito",
				"status": "published",
				"data": {
					"title": "Lemmikkihoito",
					"summary": "Hoidan koiraa, kissaa tai muuta lemmikkiä kotonasi tai omassa kodissani — aina yksi talous kerrallaan, aina sovitusti.",
					"icon": "pets",
					"order": 1,
					"body": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "svcpets1",
							"children": [
								{
									"_type": "span",
									"_key": "svcpets1s",
									"text": "Hoidan koiria, kissoja ja useimpia pieniä lemmikkejä pääkaupunkiseudulla — pidempikin matka onnistuu, jos hoitojakso on riittävän pitkä. Hoito tapahtuu useimmiten lemmikin omassa kodissa: vuorokausihoidon aikana olen paikalla koko ajan, tai niin kuin erikseen sovimme. Otan kotiini kerrallaan yhden talouden lemmikit — 1–2 kissaa tai enintään keskikokoisen koiran. Kotini on hissillinen kerrostalokaksio Länsi-Vantaalla, aivan Lammaslammen virkistysalueen kupeessa."
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "svcpets2",
							"children": [
								{
									"_type": "span",
									"_key": "svcpets2s",
									"text": "Teemme aina kirjallisen hoitosopimuksen, ja ensimmäinen tutustumiskäynti on maksuton HSL:n A–C-vyöhykkeillä. Hintaan kuuluu yksilöllinen ruokinta ja veden vaihto, leikki ja rapsutukset lemmikin toiveiden mukaan, yksilölliset ulkoilut, hiekkalaatikon siivous sekä pienet kodinhoitotyöt hoitojakson aikana. Saat päivityksiä kuvin ja videoin, ja tarvittaessa hoidan myös lääkitykset ja muut hoitotoimenpiteet. Toiminnallani on voimassa oleva vastuuvakuutus."
								}
							]
						}
					],
					"bullets": [
						{ "text": "Hoito lemmikin omassa kodissa tai luonani" },
						{ "text": "Vain yhden talouden lemmikit kerrallaan" },
						{ "text": "Lääkitykset ja yksilöllinen hoito onnistuvat" },
						{ "text": "Maksuton tutustumiskäynti pääkaupunkiseudulla" }
					]
				}
			},
			{
				"id": "svc:cleaning",
				"slug": "kodinhoito",
				"status": "published",
				"data": {
					"title": "Kodinhoitopalvelut",
					"summary": "Kodin perus- ja ylläpitosiivous — joko lemmikkihoidon yhteydessä tai omana palveluna.",
					"icon": "cleaning",
					"order": 2,
					"body": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "svcclean1",
							"children": [
								{
									"_type": "span",
									"_key": "svcclean1s",
									"text": "Huolehdin kodin siisteydestä pääasiassa sinun omilla välineilläsi: keittiön pinnat, imurointi ja pölyjen pyyhkiminen, lattioiden pesu sekä kylpyhuoneen ja WC:n pesu. Sovittaessa voin tuoda mukaan biohajoavaa desinfiointiainetta. Käytän omaa työvaatetusta ja tarvittavia suojavarusteita, ja toiminnallani on voimassa oleva vastuuvakuutus."
								}
							]
						}
					],
					"bullets": [
						{ "text": "Perus- ja ylläpitosiivous" },
						{ "text": "Pääasiassa omilla välineilläsi" },
						{ "text": "Voidaan yhdistää lemmikkihoitoon" },
						{ "text": "Myös muuttosiivoukset" }
					]
				}
			},
			{
				"id": "svc:garden",
				"slug": "puutarhanhoito",
				"status": "published",
				"data": {
					"title": "Puutarhanhoito",
					"summary": "Nurmikosta lumitöihin — pihasi hoidossa lomasi ajan tai tarpeen mukaan.",
					"icon": "garden",
					"order": 3,
					"body": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "svcgarden1",
							"children": [
								{
									"_type": "span",
									"_key": "svcgarden1s",
									"text": "Hoidan pihaa ja puutarhaa lomamatkasi ajan tai muun tarpeen mukaan: nurmikon leikkuu ja trimmaus, kasvien istutus, leikkaus ja muu ylläpito, haravointi ja lumityöt sekä pienet viherrakennustyöt. Työ tehdään pääasiassa sinun omilla työvälineilläsi, ja hinnoittelu on tunti- tai urakkaperusteista tarpeen mukaan."
								}
							]
						}
					],
					"bullets": [
						{ "text": "Nurmikon leikkuu ja trimmaus" },
						{ "text": "Istutukset ja kasvien ylläpito" },
						{ "text": "Haravointi ja lumityöt" },
						{ "text": "Tunti- tai urakkaveloitus" }
					]
				}
			}
