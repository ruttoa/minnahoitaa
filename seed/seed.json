		"pages": [
			{
				"id": "page:koti-hero",
				"slug": "koti-hero",
				"status": "published",
				"data": {
					"title": "Joku on kotona",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "herointro1",
							"children": [
								{
									"_type": "span",
									"_key": "herointro1s",
									"text": "Kun lähdet reissuun, kotisi ja lemmikkisi jäävät hyviin käsiin. Hoidan lemmikkejä, siivoan kodin ja pidän pihasta huolta Länsi-Vantaalla ja koko pääkaupunkiseudulla."
								}
							]
						}
					]
				}
			},
			{
				"id": "page:minusta",
				"slug": "minusta",
				"status": "published",
				"data": {
					"title": "Minusta",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "minusta1",
							"children": [
								{
									"_type": "span",
									"_key": "minusta1s",
									"text": "Asuin lähes kymmenen vuotta Uudessa Seelannissa. Siellä toimin vapaaehtoisena eläinsuojeluyhdistys SPCA:ssa useita kertoja viikossa parin vuoden ajan, ja silloin syntyi ajatus siitä, että haluan tehdä eläinten kanssa töitä myös jatkossa — ehkä joskus jopa oman löytöeläinkodin, pienimuotoisen luomuviljelyn kera."
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "minusta2",
							"children": [
								{
									"_type": "span",
									"_key": "minusta2s",
									"text": "Muutin Suomeen kesäkuussa 2023 ja opiskelin eläintenhoitajaksi. Työssäoppimisjaksoni olivat Helsingin Eläinsuojeluyhdistyksellä ja Löytöeläintalolla. Aloitin lemmikkien hoitamisen jo opintojen aikana kevytyrittäjänä, ja valmistuttuani perustin toiminimen. Rauhallinen luonteeni auttaa arimmatkin kaverit rentoutumaan, ja vuosien varrella olen hoitanut kaiken ikäisiä ja rotuisia koiria ja kissoja, kaneja, muita pikkujyrsijöitä sekä lintuja."
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "minusta3",
							"children": [
								{
									"_type": "span",
									"_key": "minusta3s",
									"text": "Lemmikkien hoidon rinnalla autan myös kodin siivouksessa sekä pihan ja puutarhan hoidossa."
								}
							]
						}
					]
				}
			},
