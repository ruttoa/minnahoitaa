{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "minnahoitaa",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "minnahoitaa",
		},
	],
	// The bucket must be created by hand *before* the first deploy (see README,
	// "Deploying to Cloudflare"): auto-provisioning picks no location, and a
	// bucket's jurisdiction can't be changed afterwards.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "minnahoitaa-media",
			"jurisdiction": "eu",
		},
	],
	// No "worker_loaders" (LOADER) binding: it's only for *sandboxed* plugins
	// (marketplace/registry installs, `sandboxRunner`), and needs the Workers
	// Paid plan. This site's plugins (forms, marketing-blocks) are native and
	// run in-process, so it's omitted. Re-add it, plus `sandboxRunner: sandbox()`
	// in astro.config.mjs, if sandboxed plugins are ever installed.
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
